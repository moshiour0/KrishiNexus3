# Safe local/Vercel environment template. Credential values are intentionally blank.
# Never paste real credentials into a tracked file.

# NASA POWER is public. Vercel enables live requests in api/index.py by default.
# Set to 0 for deterministic offline development and CI.
FIELD_SHIFT_LIVE_NASA=1
# FIELD_SHIFT_CACHE_DIR=
FIELD_SHIFT_POWER_MAX_IMPUTE_FRACTION=0.10
FIELD_SHIFT_POWER_MAX_GAP_DAYS=5
FIELD_SHIFT_POWER_CACHE_TTL_SECONDS=43200

# Optional AppEEARS point sampling (NASA Earthdata Login credentials).
FIELD_SHIFT_APPEEARS_USER=
FIELD_SHIFT_APPEEARS_PASSWORD=
FIELD_SHIFT_APPEEARS_RETRY_FAILED=0
FIELD_SHIFT_APPEEARS_TASK_SCAN_LIMIT=100
FIELD_SHIFT_APPEEARS_TASK_SCAN_PAGES=3
FIELD_SHIFT_APPEEARS_MAX_DAYS=366
FIELD_SHIFT_APPEEARS_CACHE_TTL_SECONDS=604800
FIELD_SHIFT_APPEEARS_WAIT_SECONDS=50

# Optional NASA NEX-GDDP-CMIP6 access through Google Earth Engine.
FIELD_SHIFT_GEE_PROJECT=
# Enter full JSON only in a server-side Vercel secret or an ignored local .env.
FIELD_SHIFT_GEE_SERVICE_ACCOUNT_JSON=
FIELD_SHIFT_GEE_CACHE_TTL_SECONDS=604800

# Optional modeled soil data; keep disabled unless its provider is verified.
FIELD_SHIFT_SOILGRIDS=0
FIELD_SHIFT_SOIL_POINT_MAX_DISTANCE_KM=1.0
